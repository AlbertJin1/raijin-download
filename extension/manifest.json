{
  "manifest_version": 3,
  "name": "Raijin Download Manager Integration",
  "short_name": "Raijin",
  "version": "2.0.0",
  "description": "Send browser downloads and links to Raijin Download Manager — by Jessie Albert Regualos (Yotsuchi).",
  "author": "Jessie Albert Regualos (Yotsuchi)",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Raijin Download Manager",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "minimum_chrome_version": "110"
}
