{
  "name": "raijin-download-manager",
  "version": "2.0.0",
  "private": true,
  "description": "Raijin Download Manager \u2014 a lightning-fast, resumable, dynamically segmented download manager for Windows.",
  "author": "Jessie Albert Regualos (Yotsuchi)",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "vite build && electron .",
    "build:web": "vite build",
    "test": "node --test tests/engine.test.cjs tests/bridge.test.cjs",
    "check": "vite build && node --check electron/main.cjs && node --check electron/preload.cjs && node --check electron/bridge.cjs && node --check electron/engine/manager.cjs && node --check electron/engine/transfer.cjs",
    "dist": "vite build && electron-builder --win nsis portable --x64 --publish never",
    "dist:portable": "vite build && electron-builder --win portable --x64 --publish never",
    "dist:setup": "vite build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.yotsuchi.raijin",
    "productName": "Raijin Download Manager",
    "copyright": "Copyright \u00a9 2026 Jessie Albert Regualos (Yotsuchi)",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "public/icons/raijin.ico",
        "to": "icons/raijin.ico"
      },
      {
        "from": "public/icons/raijin.png",
        "to": "icons/raijin.png"
      },
      {
        "from": "extension",
        "to": "extension"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "icon": "public/icons/raijin.ico",
      "executableName": "Raijin",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Raijin Download Manager by Jessie Albert Regualos (Yotsuchi)",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Raijin-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raijin Download Manager",
      "installerIcon": "public/icons/raijin.ico",
      "uninstallerIcon": "public/icons/raijin.ico",
      "uninstallDisplayName": "Raijin Download Manager",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Raijin-Portable-${version}.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "publish": null
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
